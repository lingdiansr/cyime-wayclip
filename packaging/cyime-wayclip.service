[Unit]
Description=CyIME Wayclip clipboard synchronization
After=graphical-session.target

[Service]
Type=simple
# Package installers replace @bindir@; the CLI installer writes an absolute path.
ExecStart=@bindir@/cyime-wayclip run
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
